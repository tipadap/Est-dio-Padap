# Copie para .env e ajuste (uso LOCAL). No Railway, defina pelo painel (Variables) — veja deploy/RAILWAY.md.

# Porta HTTP: só para uso local (ex.: PORT=3000). No Railway NÃO defina — a plataforma injeta.

# Ambiente: production no Railway; development no seu computador.
NODE_ENV=production

# Segredo dos cookies de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio

# Pasta de dados (banco SQLite + imagens enviadas).
# Railway: /data (o caminho do Volume).
# Local: use uma pasta FORA do OneDrive (a sincronização corrompe o SQLite), ex.: C:/EstudioPADAP_dados
DATA_DIR=/data

# Administrador inicial: criado ao subir, se o banco estiver vazio.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Link do "Suporte PADAP" (tela de login). Ex.: mailto:ti@padap.com.br ou https://wa.me/55...
SUPPORT_URL=mailto:tipadapsg@gmail.com
