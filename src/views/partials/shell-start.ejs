<%- include('head') %>
<body>
<div class="shell" id="shell">
  <button class="btn btn-sm menu-toggle" type="button" data-toggle-menu aria-label="Abrir menu"><%- icon('menu') %></button>
  <aside class="sidebar">
    <a class="brand" href="/" aria-label="Estúdio PADAP — Página Inicial"><img src="/static/img/padap-logo-branco.png" alt="PADAP Produtividade Agrícola"></a>
    <nav>
      <a class="nav-item <%= active === 'home' ? 'active' : '' %>" href="/"><%- icon('home') %> Página Inicial</a>
      <a class="nav-item <%= active === 'biblioteca' ? 'active' : '' %>" href="/biblioteca"><%- icon('book') %> Biblioteca</a>
      <div class="sep"></div>
      <a class="nav-item" href="/#novo"><%- icon('plusSquare') %> Novo</a>
      <% if (currentUser && currentUser.is_admin) { %>
        <div class="sep"></div>
        <a class="nav-item <%= active === 'imagens' ? 'active' : '' %>" href="/admin/imagens"><%- icon('image') %> Imagens</a>
        <a class="nav-item <%= active === 'usuarios' ? 'active' : '' %>" href="/admin/usuarios"><%- icon('users') %> Usuários</a>
      <% } %>
      <div class="sep"></div>
      <a class="nav-item <%= active === 'conta' ? 'active' : '' %>" href="/conta/senha"><%- icon('key') %> Trocar senha</a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="nav-item" type="submit"><%- icon('logout') %> Sair</button>
      </form>
    </nav>
    <div class="user"><strong><%= currentUser ? currentUser.name : '' %></strong><%= currentUser ? currentUser.email : '' %></div>
  </aside>
  <main class="main">
